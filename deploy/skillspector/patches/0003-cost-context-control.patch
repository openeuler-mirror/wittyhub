+def _merge_ranges(
+    ranges: list[tuple[int, int]],
+    gap_tolerance: int,
+    max_ranges: int,
+) -> list[tuple[int, int]]:
+    """Merge overlapping/nearby line ranges, then collapse until <= max_ranges."""
+    if not ranges:
+        return []
+    ordered = sorted(ranges)
+    merged: list[tuple[int, int]] = [ordered[0]]
+    for start, end in ordered[1:]:
+        last_start, last_end = merged[-1]
+        if start <= last_end + gap_tolerance + 1:
+            merged[-1] = (last_start, max(last_end, end))
+        else:
+            merged.append((start, end))
+
+    # Too many disjoint windows: repeatedly merge the closest pair.  Cheaper
+    # than emitting dozens of tiny prompts that each pay the fixed overhead.
+    while len(merged) > max_ranges:
+        best_idx = 0
+        best_gap = None
+        for i in range(len(merged) - 1):
+            gap = merged[i + 1][0] - merged[i][1]
+            if best_gap is None or gap < best_gap:
+                best_gap = gap
+                best_idx = i
+        first = merged[best_idx]
+        second = merged[best_idx + 1]
+        merged[best_idx : best_idx + 2] = [(first[0], second[1])]
+    return merged
+
+
+def _render_block(lines: list[str], start: int, end: int) -> str:
+    """Render 1-indexed inclusive line range with explicit ``L<n>:`` prefixes."""
+    return "\n".join(f"L{idx}: {lines[idx - 1]}" for idx in range(start, end + 1))
+
+
+def _split_oversized(
+    ranges: list[tuple[int, int]],
+    lines: list[str],
+    content_budget: int,
+) -> list[tuple[int, int]]:
+    """Split any range whose rendered text exceeds the per-prompt budget."""
+    out: list[tuple[int, int]] = []
+    for start, end in ranges:
+        tokens = estimate_tokens(_render_block(lines, start, end))
+        if tokens <= content_budget:
+            out.append((start, end))
+            continue
+        parts = max(2, int(tokens / content_budget) + 1)
+        step = max(1, (end - start + 1) // parts)
+        cursor = start
+        while cursor <= end:
+            out.append((cursor, min(end, cursor + step - 1)))
+            cursor += step
+    return out
+
+
+def _match_item_files(
+    batch_findings: list[Finding],
+    rule_id: str,
+    start_line: object,
+) -> set[str]:
+    """Map an LLM-judged item back to the file(s) it came from (multi-file batch)."""
+    try:
+        line = int(start_line) if start_line is not None else None  # type: ignore[arg-type]
+    except (TypeError, ValueError):
+        line = None
+    exact = {
+        f.file
+        for f in batch_findings
+        if f.rule_id == rule_id and (line is None or f.start_line == line)
+    }
+    if exact:
+        return exact
+    return {f.file for f in batch_findings if f.rule_id == rule_id}
