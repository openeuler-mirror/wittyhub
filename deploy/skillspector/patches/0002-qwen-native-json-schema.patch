+# SPDX-License-Identifier: Apache-2.0
+"""Process-wide request/token rate limiter (sliding 60s window).
+
+SiliconFlow's free tiers enforce both RPM and TPM quotas; without client-side
+pacing a concurrent scan immediately trips 429s and wastes calls.  This module
+provides a tiny thread-safe + async-compatible sliding window limiter driven by
+``SKILLSPECTOR_RPM`` / ``SKILLSPECTOR_TPM`` (0 or unset disables a dimension).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import threading
+import time
+from collections import deque
+
+from skillspector.logging_config import get_logger
+
+logger = get_logger(__name__)
+
+_WINDOW_SECONDS = 60.0
+
+
+def _env_int(name: str, default: int) -> int:
+    raw = os.environ.get(name)
+    if raw is None or not raw.strip():
+        return default
+    try:
+        return int(float(raw.strip()))
+    except ValueError:
+        logger.warning("Invalid %s=%r; using %d", name, raw, default)
+        return default
+
+
+class RateLimiter:
+    """Sliding-window limiter tracking (timestamp, tokens) events."""
+
+    def __init__(self, rpm: int = 0, tpm: int = 0):
+        self._rpm = max(0, rpm)
+        self._tpm = max(0, tpm)
+        self._events: deque[tuple[float, int]] = deque()
+        self._lock = threading.Lock()
+
+    @property
+    def enabled(self) -> bool:
+        return self._rpm > 0 or self._tpm > 0
+
+    def _prune(self, now: float) -> None:
+        cutoff = now - _WINDOW_SECONDS
+        while self._events and self._events[0][0] <= cutoff:
+            self._events.popleft()
+
+    def _plan(self, tokens: int) -> float:
+        """Reserve a slot if possible; return seconds to wait (0 = reserved)."""
+        now = time.monotonic()
+        self._prune(now)
+        wait = 0.0
+
+        if self._rpm > 0 and len(self._events) >= self._rpm:
+            oldest = self._events[0][0]
+            wait = max(wait, oldest + _WINDOW_SECONDS - now)
+
+        if self._tpm > 0:
+            used = sum(t for _, t in self._events)
+            if used + tokens > self._tpm:
+                # Walk oldest→newest until enough budget is free.
+                freed = used
+                for ts, tok in self._events:
+                    freed -= tok
+                    if freed + tokens <= self._tpm:
+                        wait = max(wait, ts + _WINDOW_SECONDS - now)
+                        break
+                else:
+                    wait = max(wait, _WINDOW_SECONDS)
+
+        # Oversized single request: let it through once (nothing else can help).
+        if wait <= 0 or tokens > self._tpm > 0:
+            self._events.append((now, tokens))
+            return 0.0
+        return wait
+
+    def acquire_sync(self, tokens: int = 1000) -> None:
+        if not self.enabled:
+            return
+        while True:
+            with self._lock:
+                wait = self._plan(tokens)
+            if wait <= 0:
+                return
+            time.sleep(min(wait, 5.0))
+
+    async def acquire(self, tokens: int = 1000) -> None:
+        if not self.enabled:
+            return
+        while True:
+            with self._lock:
+                wait = self._plan(tokens)
+            if wait <= 0:
+                return
+            await asyncio.sleep(min(wait, 5.0))
+
+
+_LIMITER: RateLimiter | None = None
+_LIMITER_LOCK = threading.Lock()
+
+
+def get_limiter() -> RateLimiter:
+    """Return the process-wide limiter configured from the environment."""
+    global _LIMITER
+    if _LIMITER is None:
+        with _LIMITER_LOCK:
+            if _LIMITER is None:
+                _LIMITER = RateLimiter(
+                    rpm=_env_int("SKILLSPECTOR_RPM", 0),
+                    tpm=_env_int("SKILLSPECTOR_TPM", 0),
+                )
+                if _LIMITER.enabled:
+                    logger.info(
+                        "Rate limiter active: rpm=%s tpm=%s",
+                        _LIMITER._rpm,
+                        _LIMITER._tpm,
+                    )
+    return _LIMITER
