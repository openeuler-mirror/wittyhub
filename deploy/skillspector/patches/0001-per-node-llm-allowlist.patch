+#: Comma-separated allowlist of the LLM-using node IDs that may call the model.
+#: Accepts ``fnmatch`` patterns and the special value ``all``; unset or empty
+#: means every node is enabled (the historical behaviour).  Examples:
+#: ``meta_analyzer`` (static analysis + LLM false-positive filtering only, no
+#: semantic discovery) or ``semantic_*`` (semantic discovery only, meta filtering
+#: falls back to keeping every static finding).
+LLM_NODES_ENV = "SKILLSPECTOR_LLM_NODES"
+
+
+def llm_node_enabled(node_id: str) -> bool:
+    """Return whether *node_id* is allowed to call the LLM.
+
+    Nodes outside the allowlist return immediately without issuing a request,
+    so one build can be run in "static + meta only" or "semantic only" mode by
+    changing a single env var.  This is the only per-node LLM switch: the
+    ``use_llm`` state flag remains all-or-nothing.
+    """
+    raw = os.environ.get(LLM_NODES_ENV, "").strip()
+    if not raw:
+        return True
+    patterns = [part.strip().lower() for part in raw.split(",") if part.strip()]
+    if not patterns or "all" in patterns:
+        return True
+    return any(fnmatch.fnmatchcase(node_id.lower(), pattern) for pattern in patterns)
+
+
 def fetch_model_token_limits(model_label: str) -> tuple[int, int]:
     """Return ``(max_input_tokens, max_output_tokens)`` for *model_label*."""
