--- a/src/skillspector/rule_scope.py	1970-01-01 08:00:00
+++ b/src/skillspector/rule_scope.py	2026-10-28 15:57:25
@@ -0,0 +1,139 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Rule-scope matrix: drop static findings whose rule cannot apply to a file class.
+
+Static regex rules fire on documentation prose far more often than on real code
+(a doc that *mentions* ``curl | bash`` is not executing it).  Sending every such
+hit to the LLM dominates scanning cost, so this module declares, per rule, which
+file classes the rule is meaningful for and suppresses the rest before the LLM
+sees them.
+
+Enabled with ``SKILLSPECTOR_RULE_SCOPE=1``; matrix can be overridden with a YAML
+file via ``SKILLSPECTOR_RULE_SCOPE_FILE`` (format: ``RULE: [class, ...]``).
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from skillspector.logging_config import get_logger
+from skillspector.models import Finding
+
+logger = get_logger(__name__)
+
+DOCS = "docs"
+INSTRUCTIONS = "instructions"
+CODE = "code"
+CONFIG = "config"
+OTHER = "other"
+
+_CODE_EXT = {
+    ".py", ".sh", ".bash", ".zsh", ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx",
+    ".rb", ".go", ".rs", ".pl", ".php", ".java", ".kt", ".c", ".cc", ".cpp", ".h",
+    ".ps1", ".bat", ".lua",
+}
+_CONFIG_EXT = {
+    ".json", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".conf", ".env", ".properties",
+    ".lock", ".xml",
+}
+_INSTRUCTION_NAMES = {"skill.md", "agents.md", "claude.md", "readme.md"}
+_INSTRUCTION_DIRS = {"references", "reference", ".claude"}
+
+# Rule -> file classes where the rule can plausibly produce a true positive.
+_BUILTIN_MATRIX: dict[str, set[str]] = {
+    "PE1": {CODE, CONFIG, INSTRUCTIONS},
+    "PE2": {CODE, CONFIG, INSTRUCTIONS},
+    "PE3": {CODE, CONFIG, INSTRUCTIONS},
+    "TM1": {CODE, CONFIG, INSTRUCTIONS},
+    "TM2": {CODE, CONFIG, INSTRUCTIONS},
+    "MP2": {CODE, CONFIG, INSTRUCTIONS},
+    "MP3": {CODE, INSTRUCTIONS},
+    "RA1": {CODE, INSTRUCTIONS},
+    "RA2": {CODE, INSTRUCTIONS},
+    "EA2": {CODE, CONFIG, INSTRUCTIONS},
+    "EA4": {CODE, CONFIG},
+    "OH1": {CODE},
+    "SC1": {CODE, CONFIG, INSTRUCTIONS},
+    "SC2": {CODE, CONFIG, INSTRUCTIONS},
+    "SC4": {CODE, CONFIG},
+}
+
+_SCOPE_ENV = "SKILLSPECTOR_RULE_SCOPE"
+_MATRIX_FILE_ENV = "SKILLSPECTOR_RULE_SCOPE_FILE"
+
+_matrix: dict[str, set[str]] | None = None
+
+
+def enabled() -> bool:
+    return os.environ.get(_SCOPE_ENV, "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def classify_path(path: str) -> str:
+    """Classify a relative file path into docs / instructions / code / config / other."""
+    p = Path(path)
+    lower_name = p.name.lower()
+    parts = [part.lower() for part in p.parts[:-1]]
+
+    if lower_name in _INSTRUCTION_NAMES:
+        return INSTRUCTIONS
+    if any(part in _INSTRUCTION_DIRS for part in parts):
+        return INSTRUCTIONS
+
+    suffix = p.suffix.lower()
+    if suffix in {".md", ".markdown", ".rst", ".txt"}:
+        # docs/ wins over generic markdown; README/SKILL already handled above.
+        if "docs" in parts or "doc" in parts:
+            return DOCS
+        return DOCS
+    if suffix in _CODE_EXT:
+        return CODE
+    if suffix in _CONFIG_EXT:
+        return CONFIG
+    return OTHER
+
+
+def _load_matrix() -> dict[str, set[str]]:
+    global _matrix
+    if _matrix is not None:
+        return _matrix
+    matrix = {rule: set(classes) for rule, classes in _BUILTIN_MATRIX.items()}
+    override = os.environ.get(_MATRIX_FILE_ENV, "").strip()
+    if override:
+        try:
+            import yaml
+
+            data = yaml.safe_load(Path(override).read_text(encoding="utf-8")) or {}
+            for rule, classes in data.items():
+                if isinstance(classes, list):
+                    matrix[str(rule)] = {str(c).strip().lower() for c in classes}
+            logger.info("Loaded rule-scope matrix override from %s", override)
+        except Exception as exc:  # noqa: BLE001 - never fail a scan over config
+            logger.warning("Failed to load rule-scope matrix %s: %s", override, exc)
+    _matrix = matrix
+    return matrix
+
+
+def rule_applies(rule_id: str, file_class: str) -> bool:
+    """True when *rule_id* may apply to *file_class*.
+
+    Unknown rules stay applicable (fail-open) so new rules are never silently
+    dropped before the matrix is updated.
+    """
+    matrix = _load_matrix()
+    allowed = matrix.get(rule_id)
+    if allowed is None:
+        return True
+    return file_class in allowed
+
+
+def split_findings(findings: list[Finding]) -> tuple[list[Finding], dict[str, int]]:
+    """Split into (applicable, suppressed counts keyed by rule id)."""
+    applicable: list[Finding] = []
+    suppressed: dict[str, int] = {}
+    for f in findings:
+        cls = classify_path(f.file)
+        if rule_applies(f.rule_id, cls):
+            applicable.append(f)
+        else:
+            suppressed[f.rule_id] = suppressed.get(f.rule_id, 0) + 1
+    return applicable, suppressed
