+# Single process-wide event loop, owned by a background thread.
+_BACKGROUND_LOOP: asyncio.AbstractEventLoop | None = None
+_BACKGROUND_LOOP_LOCK = threading.Lock()
+
+
+def _get_background_loop() -> asyncio.AbstractEventLoop:
+    """Return the process-wide event loop, starting its thread on first use."""
+    global _BACKGROUND_LOOP
+    loop = _BACKGROUND_LOOP
+    if loop is not None and not loop.is_closed():
+        return loop
+    with _BACKGROUND_LOOP_LOCK:
+        if _BACKGROUND_LOOP is None or _BACKGROUND_LOOP.is_closed():
+            loop = asyncio.new_event_loop()
+            thread = threading.Thread(
+                target=loop.run_forever,
+                name="skillspector-llm-loop",
+                daemon=True,
+            )
+            thread.start()
+            _BACKGROUND_LOOP = loop
+        return _BACKGROUND_LOOP
+
+
+def run_llm_coro(coro: Any) -> Any:
+    """Run *coro* on a single process-wide event loop.
+
+    Each LLM stage (three semantic analyzers + the meta analyzer) used to wrap
+    its work in ``asyncio.run(...)``, which creates and closes a fresh event
+    loop per stage — and the stages run in different worker threads, so a
+    per-thread loop did not help either.  Async HTTP clients keep keep-alive
+    connections bound to the loop that opened them; when a later stage reused
+    (or recycled) such a connection, the transport's ``close()`` called
+    ``loop.call_soon`` on the already-closed loop and raised
+    ``RuntimeError: Event loop is closed`` — flakily, depending on keep-alive
+    timing.  Funnelling every stage through one long-lived loop removes the
+    loop churn entirely while keeping the per-stage ``asyncio.gather``
+    concurrency intact.
+    """
+    loop = _get_background_loop()
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return asyncio.run_coroutine_threadsafe(coro, loop).result()
+    raise RuntimeError(
+        "run_llm_coro must not be called from inside a running event loop"
+    )
