# ============================================================================
# SkillSpector + Jenkins 镜像 (自包含版本)
# ============================================================================
# 用法:
#   docker build -f deploy/Dockerfile.jenkins -t skillspector-jenkins:latest deploy/
#   docker run -d --name skillspector-jenkins \
#     -p 8080:8080 -p 50000:50000 \
#     -v jenkins_home:/var/jenkins_home \
#     skillspector-jenkins:latest
#
# 环境变量 (可选):
#   JENKINS_ADMIN_PASS    admin 初始密码 (默认 admin@123456)
#   GIT_REPO_URL          SkillSpector 仓库地址
#   GIT_REF               分支/标签 (默认 main)
# ============================================================================

# ---- Stage 1: 构建 SkillSpector CLI ----
FROM python:3.12-slim AS skillspector-builder

ARG GIT_REPO_URL=https://github.com/JunchengDwain/SkillSpector.git
ARG GIT_REF=main

RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${GIT_REF}" "${GIT_REPO_URL}" /tmp/skillspector

WORKDIR /tmp/skillspector
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install pip --upgrade && \
    /opt/venv/bin/pip install --no-cache-dir .

# ---- Stage 2: Jenkins 镜像 ----
FROM jenkins/jenkins:lts

USER root

# 系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip python3-full \
        gcc make git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 从 Stage 1 复制 SkillSpector venv
COPY --from=skillspector-builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 验证 SkillSpector 安装
RUN skillspector --version

# Jenkins 插件
RUN jenkins-plugin-cli --plugins \
    "workflow-aggregator:latest" \
    "git:latest" \
    "credentials-binding:latest" \
    "pipeline-stage-view:latest" \
    "build-token-root:latest" \
    "timestamper:latest"

# 初始化脚本
COPY jenkins-init.groovy /usr/share/jenkins/ref/init.groovy.d/01-init.groovy
COPY jenkins-pipeline.groovy /usr/share/jenkins/ref/jenkins-pipeline.groovy

# 替换 admin 密码占位符
ARG JENKINS_ADMIN_PASS=admin@123456
RUN sed -i "s/ADMIN_PASS_PLACEHOLDER/${JENKINS_ADMIN_PASS}/g" \
    /usr/share/jenkins/ref/init.groovy.d/01-init.groovy

ENV SKILLSPECTOR_LOG_LEVEL=WARNING
ENV SKILLSPECTOR_PROVIDER=openai

USER jenkins